# Public runtime uses a deny-by-default allowlist.
# .assetsignore follows .gitignore syntax: ignore everything, then unignore
# only the reviewed browser assets listed in PACKAGE_CONTENTS.md.
*

# Defense-in-depth: keep prohibited categories visible during review. The
# leading "*" already excludes them; these rules document the boundary.
.git
.git/**
.github
.github/**
.wrangler
.wrangler/**
.dev.vars*
.env*
node_modules
node_modules/**
tests
tests/**
backups
backups/**
README.md
CHANGES.md
REVIEW_NOTES.md
PACKAGE_CONTENTS.md
wrangler.toml
CNAME
.nojekyll
.gitignore
.assetsignore
prototype-v2.html
sw-v5.js
v7.6-migration-test.js
__*
*.patch
*.ps1
*.zip
*.sha256
*.bak
*.tmp
*.log
*.sqlite*
*.json
*.jsonl
focus-hero-backup-*
focus-hero-raw-state-*
*recovery*
*snapshot*
*fixture*
Thumbs.db
.DS_Store

